{
  "expo": {
    "name": "UBI v1.1",
    "slug": "ubi-v-1-1",
    "version": "1.1.0",
    "orientation": "portrait",
    "scheme": "ubi",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#020806"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#020806"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ]
  }
}
